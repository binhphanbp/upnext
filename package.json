{
  "name": "upnext",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo clean",
    "db:generate": "pnpm --filter @upnext/database db:generate",
    "db:push": "pnpm --filter @upnext/database db:push",
    "db:studio": "pnpm --filter @upnext/database db:studio",
    "db:migrate": "pnpm --filter @upnext/database db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
