# UpNext Server — Environment Variables
# Copy this file to .env.local and fill in the values.

# --- App ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL + Drizzle ORM) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/upnext

# --- Clerk ---
# Get from Clerk Dashboard > API Keys > Secret Key
CLERK_SECRET_KEY=sk_test_xxxx
# Get from Clerk Dashboard > Webhooks > Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxx

# --- Auth ---
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# --- AI ---
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Queue (BullMQ + Redis) ---
# REDIS_URL=redis://localhost:6379
